<!doctype html>
<html lang="th">
 <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>แดชบอร์ดการเงินส่วนตัว</title>
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.577.0/dist/umd/lucide.min.js"></script>
  <style>
    :root{--ink:#172d29;--muted:#788781;--line:#e8ece7;--green:#176b50;--green-light:#e7f5ed;--orange:#e98b4c;--blue:#344b69;--bg:#f7f8f4}
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);color:var(--ink);font-family:"Sarabun",sans-serif}
    button,input,select{font-family:"Sarabun",sans-serif}
    button{cursor:pointer}
    button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #82bca3;outline-offset:2px}
    .shell{max-width:1280px;margin:auto;padding:32px 36px 60px}
    .topbar{display:flex;align-items:center;justify-content:space-between;padding-bottom:27px;border-bottom:1px solid var(--line);gap:20px;flex-wrap:wrap}
    .brand{display:flex;align-items:center;gap:12px;font-weight:800;font-size:20px;letter-spacing:-.5px}
    .brand-mark{width:39px;height:39px;border-radius:12px;background:var(--green);color:white;display:grid;place-items:center}
    .brand-mark svg{width:21px;height:21px}
    .top-right{font-size:13px;color:var(--muted);display:flex;align-items:center;gap:10px}
    .live-dot{width:8px;height:8px;background:#4cb789;border-radius:50%}
    .btn-icon{background:white;border:1px solid #dfe6df;color:var(--ink);border-radius:10px;padding:7px 12px;font-size:13px;font-weight:700;display:inline-flex;align-items:center;gap:6px}
    .btn-icon:hover{background:#f1f6f2}
    .hero{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin:32px 0 24px}
    .eyebrow{color:var(--green);font-size:12px;letter-spacing:1.7px;font-weight:800;text-transform:uppercase;margin:0 0 9px}
    .hero h1{font-size:34px;letter-spacing:-1.1px;line-height:1.2;margin:0 0 8px}
    .hero p{margin:0;color:var(--muted);font-size:15px}
    .wallet-badge{background:var(--green-light);border:1px solid #c6e6d5;padding:12px 18px;border-radius:14px;text-align:right}
    .wallet-badge span{display:block;font-size:12px;color:var(--green);font-weight:700}
    .wallet-badge strong{font-size:22px;color:var(--ink);font-weight:800}
    .filterbar{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:22px}
    .filter-label{font-size:13px;color:var(--muted);display:flex;align-items:center;gap:7px}
    .filter-label svg{width:16px;height:16px}
    .month-controls{display:flex;gap:12px;flex-wrap:wrap}
    .month-field{display:flex;flex-direction:column;gap:6px;min-width:190px}
    .month-field label{font-size:12px;font-weight:700;color:#65746d}
    .month-field select{width:100%;border:1px solid #dfe6df;background:white;border-radius:10px;padding:10px 35px 10px 12px;color:var(--ink);font-size:14px;font-weight:700}
    .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:17px;margin-bottom:18px}
    .card{background:white;border:1px solid var(--line);border-radius:18px;box-shadow:0 5px 24px #19342808}
    .stat{padding:23px 24px 22px;min-height:173px}
    .stat-top{display:flex;align-items:center;justify-content:space-between}
    .stat-label{font-size:14px;color:#6c7b73;font-weight:600}
    .stat-icon{width:35px;height:35px;border-radius:10px;display:grid;place-items:center}
    .stat-icon svg{width:19px;height:19px}
    .income-icon{background:#e6f4ed;color:var(--green)}
    .expense-icon{background:#fff0e6;color:var(--orange)}
    .balance-icon{background:#eaf0f7;color:var(--blue)}
    .stat-value{font-size:27px;line-height:1.25;font-weight:800;letter-spacing:-.8px;margin:12px 0 4px;overflow-wrap:anywhere}
    .compare-value{font-size:14px;color:#62736b;font-weight:700;overflow-wrap:anywhere}
    .stat-note{font-size:12px;color:#93a098;margin-top:8px}
    .charts{display:grid;grid-template-columns:minmax(0,1.75fr) minmax(310px,1fr);gap:18px;margin-bottom:18px}
    .chart-card{padding:23px 24px}
    .card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:18px}
    .card-head h2{font-size:18px;margin:0 0 3px;letter-spacing:-.3px}
    .card-head p{font-size:12px;margin:0;color:#94a098}
    .chart-wrap{position:relative;height:275px}
    .donut-wrap{height:210px;max-width:250px;margin:0 auto 8px}
    .legend{display:flex;flex-wrap:wrap;gap:8px 14px;justify-content:center}
    .legend-item{font-size:12px;color:#62736b;display:flex;align-items:center;gap:6px}
    .legend-dot{width:8px;height:8px;border-radius:50%;flex:none}
    .empty-chart{display:none;position:absolute;inset:0;align-items:center;justify-content:center;text-align:center;color:#9aa79f;font-size:13px;background:#fff}
    .transactions{padding:23px 24px}
    .transaction-list{display:flex;flex-direction:column}
    .transaction-row{display:flex;align-items:center;gap:13px;padding:13px 0;border-top:1px solid #f0f2ee}
    .transaction-row:first-child{border-top:0}
    .transaction-icon{width:39px;height:39px;flex:none;border-radius:12px;display:grid;place-items:center}
    .transaction-icon svg{width:18px;height:18px}
    .transaction-main{min-width:0;flex:1}
    .transaction-title{font-weight:700;font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .transaction-meta{font-size:12px;color:#94a098;margin-top:2px}
    .transaction-amount{font-size:15px;font-weight:800;white-space:nowrap;text-align:right}
    .transaction-bal{font-size:11px;color:#94a098;font-weight:500;display:block}
    .positive{color:var(--green)}
    .negative{color:#d77540}
    .empty-list{text-align:center;padding:35px;color:#92a098;font-size:14px}
    .expense-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:16px 0 0}
    .expense-summary-item{padding:12px;border:1px solid var(--line);border-radius:11px;background:#fbfcfa}
    .expense-summary-item span{display:block;color:var(--muted);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.expense-summary-item strong{font-size:16px;color:var(--ink)}
    .detail-scroll{overflow-x:auto}.detail-table{width:100%;min-width:760px;border-collapse:collapse;text-align:left;font-size:13px}.detail-table th,.detail-table td{padding:12px;border-bottom:1px solid #edf1ed}.detail-table th{color:#65746d;white-space:nowrap}.detail-table td.amount{text-align:right;font-weight:800;color:#d77540}.detail-table th.amount{text-align:right}.detail-table tfoot{font-weight:800;background:#f7faf7}
    .status{min-height:22px;font-size:13px;color:#65746d;margin:10px 0 0;line-height:1.6}
    .status.error{color:#a94432}.status.loading{color:var(--green)}
    .footer{padding-top:28px;color:#a0aaa3;font-size:12px;text-align:center}
    @media(max-width:850px){.charts{grid-template-columns:1fr}.stats{gap:10px}.stat{padding:19px}.stat-value{font-size:23px}}
    @media(max-width:620px){.expense-summary{grid-template-columns:repeat(2,minmax(0,1fr))}.shell{padding:20px 16px 40px}.hero{align-items:flex-start;flex-direction:column;margin-top:24px}.hero h1{font-size:28px}.wallet-badge{width:100%;text-align:left}.filterbar{align-items:stretch;flex-direction:column}.month-controls{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.month-field{min-width:0}.month-field:first-child{grid-column:1/-1}.stats{grid-template-columns:1fr}.stat{min-height:125px}.charts{gap:12px}.chart-card,.transactions{padding:19px}.chart-wrap{height:240px}.donut-wrap{height:200px}}
  </style>
 </head>
 <body>
  <div class="shell">
   <header class="topbar">
    <div class="brand">
     <span class="brand-mark"><i data-lucide="wallet"></i></span><span>เงินของฉัน<span style="color:#63a786">.</span></span>
    </div>
    <div class="top-right">
     <span class="live-dot"></span><span>เชื่อมต่อ API อัตโนมัติ</span>
     <button type="button" class="btn-icon" onclick="loadSheet()"><i data-lucide="refresh-cw" style="width:14px;height:14px"></i> รีเฟรช</button>
    </div>
   </header>

   <main>
    <section class="hero" aria-labelledby="page-title">
     <div>
      <p class="eyebrow">PERSONAL FINANCE OVERVIEW</p>
      <h1 id="page-title">ภาพรวมการเงินของคุณ</h1>
      <p>สรุปจากข้อมูลจริงในชีท · อัปเดตอัตโนมัติผ่าน Telegram Bot</p>
     </div>
     <div class="wallet-badge">
      <span>💳 ยอดเงินคงเหลือในกระเป๋าปัจจุบัน</span>
      <strong id="wallet-balance">—</strong>
     </div>
    </section>

    <section class="filterbar" aria-label="เลือกเดือนเพื่อเปรียบเทียบ">
     <div class="filter-label">
      <i data-lucide="calendar-days"></i> เริ่มต้นด้วยภาพรวมทุกเดือน · เลือกเดือนเพื่อเปลี่ยนมุมมอง
     </div>
     <div class="month-controls">
      <div class="month-field">
       <label for="overview-year">ปีที่แสดง</label>
       <select id="overview-year" aria-label="เลือกปีที่ต้องการดูภาพรวม"></select>
      </div>
      <div class="month-field">
       <label for="primary-month">มุมมองข้อมูล</label>
       <select id="primary-month" aria-label="เลือกภาพรวมทุกเดือนหรือเดือนที่ต้องการ"></select>
      </div>
      <div class="month-field">
       <label for="comparison-month">เดือนเปรียบเทียบ</label>
       <select id="comparison-month" aria-label="เลือกเดือนเปรียบเทียบ"></select>
      </div>
     </div>
    </section>

    <p id="page-status" class="status" role="status" aria-live="polite"></p>

    <section class="stats" aria-label="สรุปรายรับรายจ่ายและยอดคงเหลือ">
     <article class="card stat">
      <div class="stat-top">
       <span class="stat-label">รายรับ</span><span class="stat-icon income-icon"><i data-lucide="arrow-down-left"></i></span>
      </div>
      <div id="income-total" class="stat-value">—</div>
      <div id="income-comparison" class="compare-value">ยังไม่มีข้อมูล</div>
      <div id="income-difference" class="stat-note"></div>
     </article>
     <article class="card stat">
      <div class="stat-top">
       <span class="stat-label">รายจ่าย</span><span class="stat-icon expense-icon"><i data-lucide="arrow-up-right"></i></span>
      </div>
      <div id="expense-total" class="stat-value">—</div>
      <div id="expense-comparison" class="compare-value">ยังไม่มีข้อมูล</div>
      <div id="expense-difference" class="stat-note"></div>
     </article>
     <article class="card stat">
      <div class="stat-top">
       <span class="stat-label">ส่วนต่างสุทธิ (รับ − จ่าย)</span><span class="stat-icon balance-icon"><i data-lucide="wallet-cards"></i></span>
      </div>
      <div id="balance-total" class="stat-value">—</div>
      <div id="balance-comparison" class="compare-value">ยังไม่มีข้อมูล</div>
      <div id="balance-difference" class="stat-note"></div>
     </article>
    </section>

    <section class="charts" aria-label="กราฟการเงิน">
     <article class="card chart-card">
      <div class="card-head">
       <div>
        <h2>ภาพรวมและเปรียบเทียบรายเดือน</h2>
        <p id="comparison-caption">รายรับ รายจ่าย และส่วนต่างสุทธิ</p>
       </div>
      </div>
      <div class="chart-wrap">
       <canvas id="trend-chart"></canvas>
       <div id="trend-empty" class="empty-chart">ยังไม่มีข้อมูลในชีท</div>
      </div>
     </article>
     <article class="card chart-card">
      <div class="card-head">
       <div>
        <h2>สัดส่วนรายจ่ายตามผู้รับ / ร้านค้า</h2>
        <p id="category-caption">สัดส่วนรายจ่ายทุกเดือน</p>
       </div>
      </div>
      <div class="chart-wrap donut-wrap">
       <canvas id="category-chart"></canvas>
       <div id="category-empty" class="empty-chart">ยังไม่มีรายจ่ายในมุมมองนี้</div>
      </div>
      <div id="category-legend" class="legend"></div>
      <div id="expense-summary" class="expense-summary"></div>
     </article>
    </section>

    <section class="card chart-card" aria-labelledby="expense-detail-heading" style="margin-bottom:18px">
     <div class="card-head">
      <div>
       <h2 id="expense-detail-heading">ใช้จ่ายไปกับอะไร</h2>
       <p id="expense-detail-caption">รายละเอียดค่าใช้จ่ายจากชีท</p>
      </div>
     </div>
     <div class="detail-scroll">
      <table class="detail-table">
       <thead>
        <tr>
         <th scope="col">เดือน</th>
         <th scope="col">วันที่</th>
         <th scope="col">ผู้รับ / ร้านค้า</th>
         <th scope="col" class="amount">จำนวนเงิน</th>
         <th scope="col">รหัสอ้างอิง (Ref)</th>
         <th scope="col">บัญชีผู้โอน</th>
        </tr>
       </thead>
       <tbody id="expense-detail-body"></tbody>
       <tfoot id="expense-detail-foot"></tfoot>
      </table>
     </div>
    </section>

    <section class="card chart-card" aria-labelledby="monthly-heading" style="margin-bottom:18px;overflow-x:auto">
     <div class="card-head">
      <div>
       <h2 id="monthly-heading">ตารางสรุปรายเดือน</h2>
       <p>ข้อมูลจากชีท · บาท</p>
      </div>
     </div>
     <table style="width:100%;border-collapse:collapse;text-align:right;min-width:480px">
      <thead>
       <tr style="border-bottom:1px solid #e8ece7;color:#65746d">
        <th scope="col" style="text-align:left;padding:12px">เดือน</th>
        <th scope="col" style="padding:12px">รายรับ</th>
        <th scope="col" style="padding:12px">รายจ่าย</th>
        <th scope="col" style="padding:12px">ส่วนต่างสุทธิ</th>
       </tr>
      </thead>
      <tbody id="monthly-table-body"></tbody>
      <tfoot id="monthly-table-foot"></tfoot>
     </table>
    </section>

    <section class="card transactions" aria-labelledby="transaction-heading">
     <div class="card-head">
      <div>
       <h2 id="transaction-heading">รายการทั้งหมด</h2>
       <p id="transaction-count">0 รายการ</p>
      </div>
     </div>
     <div id="transaction-list" class="transaction-list"></div>
    </section>
   </main>
   <footer class="footer">ภาพรวมการเงินส่วนตัว • เชื่อมต่อข้อมูลจาก Google Sheets API</footer>
  </div>

  <script>
    // =========================================================================
    // วางลิงก์ Web App URL ของ Google Apps Script ที่ต่อท้ายด้วย ?key=รหัสผ่าน ตรงนี้
    // =========================================================================
    const EMBEDDED_API_URL = "https://script.google.com/macros/s/AKfycbwFvL719Nz3p61vgDESrNMB-e7YHi-mFWOInm7YKrm41rLoGD0UfC1FevZUCfaAgrIt/exec?key=nacha2026";

    const colors=['#176b50','#e98b4c','#53779d','#e8bb64','#9a79ab','#69aab0','#ca797a','#97a87c'];
    const fmt=new Intl.NumberFormat('th-TH',{style:'currency',currency:'THB',minimumFractionDigits:2});
    const monthFmt=new Intl.DateTimeFormat('th-TH',{month:'long',year:'numeric'});
    const dateFmt=new Intl.DateTimeFormat('th-TH',{day:'numeric',month:'short',year:'numeric'});
    const $=id=>document.getElementById(id);

    let records=[],walletBalance=0,selectedYear=null,primary='',comparison='',trendChart,categoryChart,loadFailed=false;

    function parseDay(value){
      if(value instanceof Date&&!isNaN(value))return value;
      const s=String(value??'').trim();
      let match=s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
      let y,m,d;
      if(match){y=+match[1];m=+match[2];d=+match[3]}
      else{
        match=s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);
        if(!match)return null;
        d=+match[1];m=+match[2];y=+match[3];
      }
      if(y>2400)y-=543;
      const date=new Date(y,m-1,d);
      return date.getFullYear()===y&&date.getMonth()===m-1&&date.getDate()===d?date:null;
    }
    function monthKey(date){return date.getFullYear()+'-'+String(date.getMonth()+1).padStart(2,'0')}
    function monthName(key){if(!key)return 'ไม่มีข้อมูล';const [y,m]=key.split('-').map(Number);return monthFmt.format(new Date(y,m-1,1))}

    function normalizedRows(){
      return records.map(r=>{
        const day=parseDay(r.date);
        const amount=Number(r.amount);
        const rawType=String(r.type||'').trim();
        const type=rawType==='รายรับ'?'income':rawType==='รายจ่าย'?'expense':null;
        return day&&type&&Number.isFinite(amount)?{...r,day,key:monthKey(day),type,amount:Math.abs(amount)}:null;
      }).filter(Boolean);
    }

    function totals(rows){
      const income=rows.filter(r=>r.type==='income').reduce((sum,r)=>sum+r.amount,0);
      const expense=rows.filter(r=>r.type==='expense').reduce((sum,r)=>sum+r.amount,0);
      return {income,expense,balance:income-expense};
    }

    function previousKey(key){const [y,m]=key.split('-').map(Number);return monthKey(new Date(y,m-2,1))}

    function updateChoices(rows){
      const years=[...new Set(rows.map(r=>r.day.getFullYear()))].sort((a,b)=>b-a);
      if(!years.includes(selectedYear))selectedYear=years[0]??null;
      const yearSelect=$('overview-year');yearSelect.replaceChildren();
      if(!years.length)yearSelect.add(new Option('ไม่มีข้อมูล',''));
      years.forEach(year=>yearSelect.add(new Option(String(year),String(year))));
      yearSelect.value=selectedYear===null?'':String(selectedYear);
      yearSelect.disabled=!years.length;

      const keys=[...new Set(rows.filter(r=>r.day.getFullYear()===selectedYear).map(r=>r.key))].sort().reverse();
      if(primary&&!keys.includes(primary))primary='';
      const firstSelect=$('primary-month');firstSelect.replaceChildren();
      firstSelect.add(new Option('ภาพรวมทุกเดือน',''));
      keys.forEach(key=>firstSelect.add(new Option(monthName(key),key)));
      firstSelect.value=primary;

      const secondSelect=$('comparison-month');secondSelect.replaceChildren();
      secondSelect.add(new Option('ไม่เปรียบเทียบ',''));
      if(primary){
        const previous=previousKey(primary);
        secondSelect.add(new Option('เดือนก่อนหน้า · '+monthName(previous),previous));
        keys.filter(key=>key!==primary&&key!==previous).forEach(key=>secondSelect.add(new Option(monthName(key),key)));
      }
      if(!primary||!Array.from(secondSelect.options).some(option=>option.value===comparison))comparison='';
      secondSelect.value=comparison;secondSelect.disabled=!primary;
    }

    function render(){
      $('wallet-balance').textContent=fmt.format(walletBalance);
      const allRows=normalizedRows();
      updateChoices(allRows);
      const rows=allRows.filter(r=>r.day.getFullYear()===selectedYear);
      const first=primary?rows.filter(r=>r.key===primary):rows;
      const second=comparison?rows.filter(r=>r.key===comparison):[];
      const a=totals(first),b=totals(second);

      for(const field of ['income','expense','balance']){
        $(field+'-total').textContent=first.length?fmt.format(a[field]):'—';
        $(field+'-comparison').textContent=!first.length?(loadFailed?'อ่านข้อมูลจากชีทไม่ได้':'ยังไม่มีข้อมูลในมุมมองนี้'):comparison?monthName(comparison)+' · '+(second.length?fmt.format(b[field]):'ไม่มีข้อมูล'):primary?'มุมมองเดือน '+monthName(primary):'ยอดรวมปี '+selectedYear;
        const diff=a[field]-b[field];
        $(field+'-difference').textContent=!first.length?'':comparison&&second.length?'ส่วนต่างจากเดือนเปรียบเทียบ '+(diff>0?'+':diff<0?'−':'')+fmt.format(Math.abs(diff)):primary?'เลือกเดือนเปรียบเทียบได้ด้านบน':'เลือกเดือนเพื่อดูข้อมูลเฉพาะเดือน';
      }

      $('comparison-caption').textContent=comparison?monthName(primary)+' เทียบกับ '+monthName(comparison):primary?'รายรับ รายจ่าย และส่วนต่างสุทธิ · '+monthName(primary):'รายรับ รายจ่าย และส่วนต่างสุทธิ · ปี '+selectedYear;
      $('category-caption').textContent='สัดส่วนรายจ่าย · '+(primary?monthName(primary):'ปี '+selectedYear);
      $('transaction-heading').textContent=primary?'รายการของ '+monthName(primary):'รายการทั้งหมด';
      $('transaction-count').textContent=first.length+' รายการ · '+(primary?monthName(primary):'ทุกเดือน');
      $('monthly-heading').nextElementSibling.textContent=selectedYear===null?'ยังไม่มีข้อมูล':'ปี '+selectedYear+' · บาท';

      const tableBody=$('monthly-table-body');tableBody.replaceChildren();
      const monthKeys=[...new Set(rows.map(r=>r.key))].sort();
      if(!monthKeys.length){
        const tr=document.createElement('tr'),td=document.createElement('td');
        td.colSpan=4;td.textContent=loadFailed?'อ่านข้อมูลจากชีทไม่ได้':'ยังไม่มีข้อมูลในมุมมองนี้';
        td.style.textAlign='center';td.style.padding='24px';tr.append(td);tableBody.append(tr);
      }
      monthKeys.map(key=>({key,...totals(rows.filter(r=>r.key===key))})).forEach(m=>{
        const tr=document.createElement('tr');tr.style.borderBottom='1px solid #f0f2ee';
        [monthName(m.key),fmt.format(m.income),fmt.format(m.expense),fmt.format(m.balance)].forEach((value,i)=>{
          const cell=document.createElement(i?'td':'th');cell.textContent=value;cell.style.padding='12px';
          if(!i){cell.scope='row';cell.style.textAlign='left'}
          tr.append(cell);
        });
        tableBody.append(tr);
      });

      const foot=$('monthly-table-foot');foot.replaceChildren();
      if(monthKeys.length){
        const totalRow=document.createElement('tr');totalRow.style.fontWeight='800';
        ['รวม '+monthKeys.length+' เดือน',fmt.format(totals(rows).income),fmt.format(totals(rows).expense),fmt.format(totals(rows).balance)].forEach((value,i)=>{
          const cell=document.createElement(i?'td':'th');cell.textContent=value;cell.style.padding='14px 12px';
          if(!i){cell.scope='row';cell.style.textAlign='left'}
          totalRow.append(cell);
        });
        foot.append(totalRow);
      }

      renderCharts(first,a,b,rows);
      renderExpenseDetails(first);
      renderList(first);
    }

    function renderCharts(rows,a,b,allRows){
      $('trend-empty').textContent=loadFailed?'อ่านข้อมูลจากชีทไม่ได้':allRows.length?'':'ยังไม่มีข้อมูลในมุมมองนี้';
      $('trend-empty').style.display=allRows.length?'none':'flex';
      if(trendChart)trendChart.destroy();
      if(allRows.length){
        let labels,datasets;
        if(primary){
          labels=['รายรับ','รายจ่าย','ส่วนต่างสุทธิ'];
          datasets=[{label:monthName(primary),data:[a.income,a.expense,a.balance],backgroundColor:'#176b50',borderRadius:6}];
          if(comparison)datasets.push({label:monthName(comparison),data:[b.income,b.expense,b.balance],backgroundColor:'#9cbcaf',borderRadius:6});
        }else{
          const keys=[...new Set(allRows.map(r=>r.key))].sort();
          labels=keys.map(monthName);
          const monthly=keys.map(key=>totals(allRows.filter(r=>r.key===key)));
          datasets=[
            {label:'รายรับ',data:monthly.map(t=>t.income),backgroundColor:'#176b50',borderRadius:6},
            {label:'รายจ่าย',data:monthly.map(t=>t.expense),backgroundColor:'#e98b4c',borderRadius:6},
            {label:'ส่วนต่างสุทธิ',data:monthly.map(t=>t.balance),backgroundColor:'#53779d',borderRadius:6}
          ];
        }
        trendChart=new Chart($('trend-chart'),{
          type:'bar',
          data:{labels,datasets},
          options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{usePointStyle:true,boxWidth:8,font:{family:'Sarabun'}}},tooltip:{callbacks:{label:c=>' '+c.dataset.label+': '+fmt.format(c.parsed.y)}}},scales:{x:{title:{display:true,text:primary?'ประเภทยอดเงิน':'เดือน',font:{family:'Sarabun'}},grid:{display:false},ticks:{font:{family:'Sarabun'}}},y:{title:{display:true,text:'จำนวนเงิน (บาท)',font:{family:'Sarabun'}},grid:{color:'#edf1ed'},ticks:{callback:v=>new Intl.NumberFormat('th-TH',{notation:'compact'}).format(v),font:{family:'Sarabun'}}}}}
        });
      }

      const grouped={};
      rows.filter(r=>r.type==='expense'&&r.amount>0).forEach(r=>{
        const key=(r.receiver&&r.receiver!=='-')?r.receiver:'อื่น ๆ';
        grouped[key]=(grouped[key]||0)+r.amount;
      });
      const labels=Object.keys(grouped).sort((x,y)=>grouped[y]-grouped[x]);
      $('category-empty').textContent=loadFailed?'อ่านข้อมูลจากชีทไม่ได้':'ยังไม่มีรายจ่ายในมุมมองนี้';
      $('category-empty').style.display=labels.length?'none':'flex';
      $('category-legend').replaceChildren();
      const summary=$('expense-summary');summary.replaceChildren();

      labels.slice(0,6).forEach((label)=>{
        const box=document.createElement('div');box.className='expense-summary-item';
        const name=document.createElement('span');name.textContent=label;name.title=label;
        const value=document.createElement('strong');value.textContent=fmt.format(grouped[label]);
        box.append(name,value);summary.append(box);
      });
      labels.slice(0,8).forEach((label,i)=>{
        const item=document.createElement('span');item.className='legend-item';
        const dot=document.createElement('span');dot.className='legend-dot';dot.style.background=colors[i%colors.length];
        item.append(dot,document.createTextNode(label));$('category-legend').append(item);
      });

      if(categoryChart)categoryChart.destroy();
      if(labels.length){
        categoryChart=new Chart($('category-chart'),{
          type:'doughnut',
          data:{labels,datasets:[{data:labels.map(k=>grouped[k]),backgroundColor:labels.map((_,i)=>colors[i%colors.length]),borderWidth:4,borderColor:'#fff',hoverOffset:5}]},
          options:{responsive:true,maintainAspectRatio:false,cutout:'70%',plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>' '+c.label+': '+fmt.format(c.parsed)}}}}
        });
      }
    }

    function renderExpenseDetails(rows){
      const expenses=rows.filter(r=>r.type==='expense').sort((a,b)=>b.day-a.day||String(b.time||'').localeCompare(String(a.time||'')));
      $('expense-detail-caption').textContent='รายละเอียดค่าใช้จ่าย · '+(primary?monthName(primary):selectedYear===null?'ยังไม่มีข้อมูล':'ปี '+selectedYear);
      const body=$('expense-detail-body'),foot=$('expense-detail-foot');body.replaceChildren();foot.replaceChildren();
      expenses.forEach(r=>{
        const tr=document.createElement('tr');
        [monthName(r.key),dateFmt.format(r.day)+' '+(r.time||''),r.receiver||'-',fmt.format(r.amount),r.ref||'-',r.sender||'-'].forEach((value,i)=>{
          const td=document.createElement('td');td.textContent=value;if(i===3)td.className='amount';tr.append(td);
        });
        body.append(tr);
      });
      if(!expenses.length){
        const tr=document.createElement('tr'),td=document.createElement('td');
        td.colSpan=6;td.textContent=loadFailed?'อ่านข้อมูลจากชีทไม่ได้':'ไม่มีรายการจ่ายในมุมมองนี้';
        tr.append(td);body.append(tr);
      }else{
        const tr=document.createElement('tr'),label=document.createElement('th'),total=document.createElement('td');
        label.colSpan=3;label.textContent='รวมค่าใช้จ่าย';total.className='amount';
        total.textContent=fmt.format(expenses.reduce((sum,r)=>sum+r.amount,0));
        tr.append(label,total);
        const rest=document.createElement('td');rest.colSpan=2;tr.append(rest);foot.append(tr);
      }
    }

    function renderList(rows){
      const list=$('transaction-list');list.replaceChildren();
      const sorted=[...rows].sort((a,b)=>b.day-a.day||String(b.time||'').localeCompare(String(a.time||'')));
      if(!sorted.length){
        const empty=document.createElement('div');empty.className='empty-list';
        empty.textContent=loadFailed?'อ่านข้อมูลจากชีทไม่ได้':primary?'ยังไม่มีรายการในเดือนนี้':'ยังไม่มีรายการในชีท';
        list.append(empty);return;
      }
      sorted.forEach(r=>{
        const row=document.createElement('div');row.className='transaction-row';
        const icon=document.createElement('span');icon.className='transaction-icon '+(r.type==='income'?'income-icon':'expense-icon');
        icon.innerHTML='<i data-lucide="'+(r.type==='income'?'arrow-down-left':'arrow-up-right')+'"></i>';
        const main=document.createElement('div');main.className='transaction-main';
        const title=document.createElement('div');title.className='transaction-title';
        title.textContent=r.type==='income'?(r.sender||r.receiver||'รายรับ'):(r.receiver||r.sender||'รายจ่าย');
        const meta=document.createElement('div');meta.className='transaction-meta';
        meta.textContent=[r.type==='income'?'รายรับ':'รายจ่าย',dateFmt.format(r.day),r.time?r.time+' น.':'',r.ref&&r.ref!=='-'?'Ref: '+r.ref:''].filter(Boolean).join(' · ');
        main.append(title,meta);
        const amount=document.createElement('div');amount.className='transaction-amount '+(r.type==='income'?'positive':'negative');
        amount.innerHTML=(r.type==='income'?'+':'−')+fmt.format(r.amount)+`<span class="transaction-bal">คงเหลือ ${fmt.format(r.balance||0)}</span>`;
        row.append(icon,main,amount);list.append(row);
      });
      lucide.createIcons();
    }

    $('overview-year').addEventListener('change',e=>{selectedYear=Number(e.target.value);primary='';comparison='';render()});
    $('primary-month').addEventListener('change',e=>{primary=e.target.value;comparison='';render()});
    $('comparison-month').addEventListener('change',e=>{comparison=e.target.value;render()});

    function setStatus(message,kind=''){
      $('page-status').textContent=message;
      $('page-status').className='status '+kind;
    }

    async function loadSheet(){
      if(!EMBEDDED_API_URL || EMBEDDED_API_URL.includes("ใส่_URL_ของคุณตรงนี้")){
        setStatus('กรุณานำลิงก์ Web App API มาใส่ในตัวแปร EMBEDDED_API_URL ในโค้ดก่อนครับ','error');
        return;
      }
      setStatus('กำลังดึงข้อมูลล่าสุดจาก Google Sheets…','loading');
      try{
        const res=await fetch(EMBEDDED_API_URL);
        const json=await res.json();
        if(json.status!=='success')throw new Error(json.message||'ไม่สามารถดึงข้อมูลได้');
        loadFailed=false;
        records=json.data||[];
        walletBalance=Number(json.currentBalance)||0;
        render();
        setStatus(`อัปเดตข้อมูลล่าสุดเรียบร้อย (${records.length} รายการในชีท)`);
      }catch(e){
        loadFailed=true;records=[];render();
        setStatus('เชื่อมต่อ API ไม่สำเร็จ: '+e.message,'error');
      }
    }

    lucide.createIcons();
    render();
    loadSheet();
  </script>
 </body>
</html>
